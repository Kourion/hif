{
  "id": "./",
  "name": "HIF to JPG",
  "short_name": "HIF to JPG",
  "description": "Convert 10-bit HEIF (.HIF) photos from Sony cameras to JPG on your device. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1f2226",
  "theme_color": "#1f2226",
  "categories": ["photo", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photos",
          "accept": ["image/heif", "image/heic", "image/heif-sequence", "image/*", "application/octet-stream", ".hif", ".heif", ".heic"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": { "image/heif": [".hif", ".heif"], "image/heic": [".heic"] }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
